# Site-specific values, in one place instead of scattered through launch files.
#
#     cp scripts/onsite.env.example scripts/onsite.env
#     edit scripts/onsite.env
#     source scripts/setup_robot_env.sh      # on the board
#     source scripts/setup_ground_env.sh     # on the ground station
#
# onsite.env is gitignored: it holds addresses and a mount pose that belong to
# one robot at one site, and copying someone else's is how a wrong camera
# transform ends up on a robot.

# ---------------------------------------------------------------- networking
# The interface each machine uses to reach the other. CycloneDDS is bound to
# these by name, and Unitree's own setup.sh binds to a single wired interface,
# which is why a wireless link discovers nothing until this is set.
export ROBOT_NET_IF=wlan0
export GROUND_NET_IF=wlp4s0

# Address of the other machine, used by scripts/check_robot_link.sh.
export ROBOT_IP=192.168.12.1
export GROUND_IP=192.168.12.100

# Both machines must agree. Unitree's own traffic is on 0; a separate domain
# keeps the navigation stack out of it, at the cost of not seeing unitree_go
# topics. Leave at 0 unless there is a reason.
export ROS_DOMAIN_ID=0

# CycloneDDS, because Unitree's stack uses it and FastRTPS cannot talk to it.
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# ------------------------------------------------------------------- sensor
# Mount tilt to undo, and sensor height above the floor. These must match the
# values the map was built with by pcd_to_map or livox_slam.launch.py.
# 13.0 / 0.0 is Unitree's published Mid-360 mount pose; 10.26 / 1.72 is what
# was fitted from the 02_loop cloud. Fit it from the site cloud rather than
# trusting either.
export LIO_PITCH_DEG=13.0
export LIO_ROLL_DEG=0.0
export SENSOR_HEIGHT=0.35

# Interface the Unitree SDK talks to the robot over. Not the same as
# ROBOT_NET_IF: this is the robot's internal network.
export UNITREE_IF=eth0

# --------------------------------------------------------------------- site
# Absolute path on the ground station. The default in the launch file is the
# bench artefact from 02_loop, which is not the site.
export SITE_MAP=/home/sys20/projects/systonic-2307/Systronic/src/go2_control/map/livox_slam_02loop.yaml

# ------------------------------------------------------------------- camera
# base_link -> camera_link, needed by AprilTag and by nothing else. MEASURE IT.
# A wrong camera pose does not disable AprilTag, it makes AprilTag place the
# robot confidently in the wrong place.
export CAMERA_X=0.30
export CAMERA_Y=0.0
export CAMERA_Z=0.08
export CAMERA_YAW=0.0
export CAMERA_PITCH=0.0
export CAMERA_ROLL=0.0

# --------------------------------------------------------------------- mqtt
export MQTT_BROKER=192.168.68.62
export MQTT_PORT=1883

# ------------------------------------------------------------------ movement
# Left empty on purpose. Setting it is the last gate before the robot can move,
# and it belongs on the command line for one deliberate run, not in a file that
# gets sourced by habit:
#
#   ros2 launch go2_control livox_robot.launch.py replay:=false \
#       enable_cmd_vel:=true cmd_vel_topic:=/cmd_vel \
#       robot_ack:=I_UNDERSTAND_THIS_CAN_MOVE_THE_REAL_ROBOT
export ROBOT_ACK=
