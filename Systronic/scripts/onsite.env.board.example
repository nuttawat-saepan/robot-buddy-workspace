# The board's own onsite.env, as it was on 2026-09-07 - the day the whole
# stack first ran on the robot end to end.
#
#     scp scripts/onsite.env.board.example \
#         unitree@<board>:~/go2_ws/scripts/onsite.env
#
# This file is kept because the live one is not. deploy_to_board.sh excludes
# onsite.env on purpose: UNITREE_IF names a different card on each machine, so
# syncing the MiniPC's copy over the board's would break the bridge silently.
# The cost of that exclusion is that the board's copy exists nowhere else, and
# it was lost with the workspace when the board was cleared. This is the
# record, not a file to be sourced from here.
#
# The addresses are from one afternoon on one site's Wi-Fi and will be wrong on
# the next visit. The interface names and the mount geometry will not be.

# The card the board uses to reach the ground station. Not the same as
# UNITREE_IF: this one is wireless and carries the ROS graph.
export ROBOT_NET_IF=wlan0

# The card the board uses to reach the robot's own internal network, where the
# Mid-360 and the Unitree stack live. On the board this is eth0; on the MiniPC
# it was enp3s0. Getting this wrong is the worst failure in this project - the
# bridge arms, reports itself ready, and no command reaches the legs.
export UNITREE_IF=eth0

export ROBOT_IP=192.168.80.109
export GROUND_IP=192.168.80.212

# Not 0. Unitree's own traffic is on domain 0, and every ROS node this project
# starts there segfaults against the robot's graph - measured in rclpy and
# rclcpp alike. setup_sdk_env.sh moves to 0 deliberately for the bridge, which
# does not create a ROS node at all.
export ROS_DOMAIN_ID=43

# The physical mount, measured rather than fitted. 13.0/0.0/0.35 beat the
# 10.26/1.72/0.43 fitted from the cloud, even against a map built with the
# fitted values - see LIVOX_AMCL_TUNING_2026-09-03.md.
export LIO_PITCH_DEG=13.0
export LIO_ROLL_DEG=0.0
export SENSOR_HEIGHT=0.35

export SITE_MAP=$HOME/go2_ws/install/go2_control/share/go2_control/map/livox_site_20260907_1231.yaml

# The web's broker, which is the same host as the frontend and backend.
export MQTT_BROKER=192.168.80.233

# What unitree_udp_bridge is started with. Its clamp is a command line
# argument on a separate process, not a ROS parameter, so nothing can read it
# back - mqtt_mission_bridge has to be told, and the web panel reports what it
# is told. Keep these two equal to the --max-linear and --max-angular on the
# bridge command line. On 2026-09-07 Nav2 was set to 0.40 while the bridge cut
# at 0.25 and no part of the system said so.
export BRIDGE_MAX_LINEAR=0.45
export BRIDGE_MAX_ANGULAR=0.60
