<?xml version="1.0"?>
<!--
  A box the size of the Go2W footprint carrying a sensor where the Mid-360 sits.
  For testing what the stack does about obstacles. It is not a model of the
  robot: it has no legs or wheels, and braking comes from sim_actuator's assumed
  numbers rather than from physics.

  The body stops at 0.30 m so that the sensor, at 0.35 m and 13 degrees nose
  down, is above it and not inside it. It reads commands from /sim/cmd_vel, so
  nothing in the simulation listens to /cmd_vel.
-->
<sdf version="1.6">
  <model name="go2w_box">
    <pose>0 0 0 0 0 0</pose>
    <link name="base_link">
      <gravity>false</gravity>
      <inertial>
        <pose>0 0 0.175 0 0 0</pose>
        <mass>15.0</mass>
        <inertia>
          <ixx>0.5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.9</iyy><iyz>0</iyz>
          <izz>0.9</izz>
        </inertia>
      </inertial>
      <collision name="body">
        <pose>0 0 0.175 0 0 0</pose>
        <geometry><box><size>0.70 0.50 0.25</size></box></geometry>
        <surface>
          <friction><ode><mu>0</mu><mu2>0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="body">
        <pose>0 0 0.175 0 0 0</pose>
        <geometry><box><size>0.70 0.50 0.25</size></box></geometry>
      </visual>

      <!-- Mid-360: 360 degrees around, -7 to +52 up, 0.1 m minimum, 2 cm noise.
           A regular grid, where the real sensor's pattern is not repetitive. -->
      <sensor name="mid360" type="ray">
        <pose>0.30 0 0.35 0 0.2269 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>240</samples>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>45</samples>
              <min_angle>-0.1222</min_angle>
              <max_angle>0.9076</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.10</min>
            <max>40.0</max>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <plugin name="mid360_cloud" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=/livox/lidar</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>livox_frame</frame_name>
        </plugin>
      </sensor>
    </link>

    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <remapping>cmd_vel:=/sim/cmd_vel</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <publish_rate>30</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </model>
</sdf>
